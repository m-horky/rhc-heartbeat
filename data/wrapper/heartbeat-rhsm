#!/bin/sh
# SELinux transition wrapper for subscription-manager, used by rhc-heartbeat
# to collect subman facts.
#
# The heartbeat daemon runs in domain rhc_heartbeat_t, which does not include
# any rules from subscription-manager's Python code. The domain RHEL ships
# for subscription-manager, rhsmcertd_t, can only be entered by executing
# a file that holds an entrypoint permission for rhsmcertd_exec_t, which is
# /usr/sbin/rhsmcertd under regular conditions.
# /usr/sbin/subscription-manager is a generic bin_t, and rhsmcertd_t holds
# no entrypoint for bin_t.
#
# This wrapper carries the rhc_heartbeat_rhsm_exec_t label declared by
# our own policy, which is allowed to transition into rhsmcertd_t.
# Here we execute the real binary that rhsmcertd_t is allowed to run with
# no further transitions (execute_no_trans on bin_t).
exec /usr/sbin/subscription-manager "$@"
