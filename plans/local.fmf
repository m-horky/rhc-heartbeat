# Run the tests locally.
#
# Requires `make build`.

summary: Local environment
enabled: false
provision:
    how: local
environment:
    HEARTBEAT_BIN: $TMT_TREE/.tmt-artifacts/heartbeat
    PROMETHEUS_URL: http://127.0.0.1:9090
prepare:
  - name: prometheus-check
    how: shell
    script: $TMT_TREE/tests/scripts/prometheus.sh check
    order: 10
  - name: sandbox-root
    how: shell
    script: $TMT_TREE/tests/scripts/sandbox.sh
    order: 20
execute:
    how: tmt

/tier1:
    summary: Basic use-cases
    enabled: true
    discover:
        how: fmf
        filter: tier:1

/tier2:
    summary: Resilience and edge cases
    enabled: true
    discover:
        how: fmf
        filter: tier:2
